[core]
    excludesfile = ~/.gitignore_global
    editor = nvim
    pager = delta

[interactive]
    diffFilter = delta --color-only

# AI が書いたコード等をじっくり読む用の diff pager 設定。
# side-by-side は GitHub の PR diff に近い見た目でレビューしやすい。
[delta]
    navigate = true
    line-numbers = true
    side-by-side = true

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    default = current

[alias]
    st = status
    co = checkout
    br = branch
    cm = commit
    df = diff
    lg = log --oneline --graph --decorate
    b = branch
  psoh = push origin HEAD
[user]
	name = onigiri.w2
	email = onigiri.w2@gmail.com

[url "git@github.com:"]
	insteadOf = https://github.com/
