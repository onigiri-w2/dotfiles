[core]
    excludesfile = ~/.gitignore_global
    editor = nvim
    pager = delta

[interactive]
    diffFilter = delta --color-only

# AI が書いたコード等をじっくり読む用の diff pager 設定。
# side-by-side は GitHub の PR diff に近い見た目でレビューしやすい。
[delta]
    navigate = true
    line-numbers = true
    side-by-side = true

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    default = current

[alias]
    st = status
    co = checkout
    br = branch
    cm = commit
    df = diff
    lg = log --oneline --graph --decorate
    b = branch
  psoh = push origin HEAD
[user]
	name = onigiri.w2
	email = onigiri.w2@gmail.com

[url "git@github.com:"]
	pushInsteadOf = https://github.com/

# マシン固有の上書き（git 管理外の実ファイル。無ければ無視される）。
# 会社マシンでは [user] を会社名義にする等。上の設定を上書きするため末尾に置く。
# dotfiles リポジトリ自体は features/git/install.zsh がリポジトリ単位で個人名義に固定する。
[include]
	path = ~/.gitconfig.local
