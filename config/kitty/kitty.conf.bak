
# -------------------- #
# フォント
# -------------------- #
font_size 18
font_family="Monaco"
bold_font        auto
italic_font      auto
bold_italic_font auto




# ターミナルのヘッダーを隠す
# ウィンドウの装飾を無効化しつつ、特定の要素のみを残す
hide_window_decorations titlebar-only

placement_strategy center
background_opacity 0.9




# BEGIN_KITTY_THEME
# Monokai
include current-theme.conf
# END_KITTY_THEME
#
